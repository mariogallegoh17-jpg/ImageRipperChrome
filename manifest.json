{
  "manifest_version": 3,
  "name": "Image Ripper",
  "version": "1.0.0",
  "description": "Detecta y descarga imágenes de la página actual.",
  "permissions": [
    "downloads",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Image Ripper",
    "default_popup": "popup.html"
  }
}
